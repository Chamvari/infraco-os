# ─────────────────────────────────────────────────────────────
# infraco-os  –  Production environment
# Copy to docker/.env and fill in every <CHANGE_ME> before install.sh:
#   cp docker/.env.production.example docker/.env
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DB_NAME=infraco_os
DB_USER=infraco
DB_PASSWORD=<CHANGE_ME>                # strong, min 20 chars

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=<CHANGE_ME>             # openssl rand -hex 24

# ── API · auth ───────────────────────────────────────────────
# Names match src/modules/auth/token.service.ts. TTL is in SECONDS.
AUTH_JWT_SECRET=<CHANGE_ME>            # openssl rand -hex 32
AUTH_JWT_TTL_SECONDS=86400            # 86400 = 24h  (code default is 28800 = 8h)

# ── Africa's Talking (SMS + USSD) ────────────────────────────
AT_USERNAME=<CHANGE_ME>               # AT account username (use 'sandbox' for free testing)
AT_API_KEY=<CHANGE_ME>                # AT dashboard → API Key
AT_SENDER_ID=InfraCo                  # branded sender (apply for it in the AT dashboard)
AT_USSD_CODE=*384*57#                 # your registered USSD shortcode

# ── Payments (EOS switch) ────────────────────────────────────
PAYMENTS_API_BASE_URL=https://payments.eos.co.zw/api
PAYMENTS_API_KEY=<CHANGE_ME>
PAYMENTS_CALLBACK_HMAC_SECRET=<CHANGE_ME>

# ── Not yet consumed by the API (reserved) ───────────────────
# The app does not currently read CORS_ORIGIN (main.ts enables no CORS;
# the SPA is same-origin behind Nginx). Kept here for when it's wired up.
# CORS_ORIGIN=https://your.domain

# ── For future `prisma migrate deploy` only ──────────────────
# Migrations CANNOT run through PgBouncer transaction pooling — they need a
# DIRECT connection to Postgres. If/when you run migrations against prod,
# point Prisma's directUrl here (and add directUrl to prisma/schema.prisma):
# DIRECT_DATABASE_URL=postgresql://infraco:<DB_PASSWORD>@db:5432/infraco_os

# ── SMS (SmsService) — EOS Gateway default; smspop fallback ──
# Blank SMS_GATEWAY_KEY => stub mode (no send). Fill URL+key to go live.
SMS_MODE=gateway
SMS_GATEWAY_URL=http://41.220.23.94:9070
SMS_GATEWAY_KEY=
# SMSPOP_TOKEN=
# SMSPOP_SENDER_ID=CPAY202
