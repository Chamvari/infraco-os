{
  "name": "infraco-os",
  "version": "0.1.0",
  "description": "InfraCo OS — LFH property, agro, utilities & infrastructure operations platform",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U infraco -d infraco_os",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:allocation": "jest test/allocation-lock.e2e-spec.ts --config ./test/jest-e2e.json --runInBand",
    "test:vend-idempotency": "jest test/vend-idempotency.e2e-spec.ts --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.10.0",
    "bullmq": "^5.78.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "pg": "^8.11.3",
    "prisma": "^5.10.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
