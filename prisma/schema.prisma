// InfraCo OS — Prisma schema (Phase 1 subset)
//
// The SQL schema in db/infraco_os_schema.sql is the SOURCE OF TRUTH.
// This file is a hand-written starting point for the Phase 1 tables so the
// backend can compile immediately. Once the DB is applied, you can regenerate
// the full, accurate schema with:
//
//     npm run prisma:pull   # introspect the live DB into this file
//     npm run prisma:generate
//
// Note: enums and the reserve_plot() stored procedure live in SQL. Prisma calls
// the procedure via $queryRaw (see SalesService.reservePlot).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["core", "fin", "sales"]
  extensions = [pgcrypto, postgis, pg_trgm, btree_gist]
}

/// ---- core ----
model AppUser {
  user_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username    String   @unique
  full_name   String
  email       String?  @unique
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("app_user")
  @@schema("core")
}

/// ---- fin ----
model Customer {
  customer_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_type  String    // enum fin.customer_type in DB
  first_name     String
  last_name      String
  id_number      String?
  phone          String?
  email          String?
  country        String?
  wallet_id      String?
  kyc_status     String    @default("pending")
  dpa_consent    Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  accounts       Account[]

  @@map("customer")
  @@schema("fin")
}

model Account {
  account_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id  String    @db.Uuid
  account_type String    // enum fin.account_type in DB
  reference    String    @unique
  status       String    @default("active")
  balance      Decimal   @default(0) @db.Decimal(18, 2)
  currency     String    @default("USD")
  opened_at    DateTime  @default(now()) @db.Timestamptz(6)
  customer     Customer  @relation(fields: [customer_id], references: [customer_id])
  invoices     Invoice[]

  @@map("account")
  @@schema("fin")
}

model Invoice {
  invoice_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id        String   @db.Uuid
  invoice_type      String   // enum fin.invoice_type in DB
  reference         String   @unique
  amount            Decimal  @db.Decimal(18, 2)
  amount_paid       Decimal  @default(0) @db.Decimal(18, 2)
  currency          String   @default("USD")
  due_date          DateTime @db.Date
  status            String   @default("draft")
  description       String?
  platform_bill_id  String?
  source_table      String?
  source_id         String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  account           Account  @relation(fields: [account_id], references: [account_id])

  @@map("invoice")
  @@schema("fin")
}

/// ---- sales ----
model Plot {
  plot_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  development_id String   @db.Uuid
  plot_number    String
  plot_type      String   // enum sales.plot_type in DB
  area_sqm       Decimal? @db.Decimal(14, 2)
  area_ha        Decimal? @db.Decimal(12, 4)
  price          Decimal? @db.Decimal(18, 2)
  currency       String   @default("USD")
  status         String   @default("available") // enum sales.plot_status in DB
  customer_id    String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("plot")
  @@schema("sales")
}

model Reservation {
  reservation_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plot_id        String   @db.Uuid
  customer_id    String?  @db.Uuid
  agent_id       String?  @db.Uuid
  status         String   @default("active")
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  expires_at     DateTime @db.Timestamptz(6)

  @@map("reservation")
  @@schema("sales")
}
