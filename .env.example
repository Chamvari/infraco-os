# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL="postgresql://infraco:dev_change_me@localhost:5432/infraco_os?schema=public"

# Payments Platform integration (Module H) — placeholders until the platform team confirms (SRS §15, §18)
PAYMENTS_API_BASE_URL="https://payments.example/api"
PAYMENTS_API_KEY="set_me"
PAYMENTS_CALLBACK_HMAC_SECRET="set_me"

# SMS — SMSPop only (src/modules/notifications/sms-provider.ts).
# Blank SMSPOP_TOKEN => stub mode (logs, no send) in dev.
SMS_PROVIDER=smspop
SMSPOP_API_BASE_URL=https://smspop.co.zw
SMSPOP_TOKEN=
SMSPOP_SENDER_ID=InfraCo
SMSPOP_TLS_INSECURE=false
